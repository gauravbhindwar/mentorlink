# Exclude node_modules (will be installed inside container)
node_modules

# Exclude Next.js build output and cache
.next
out

# Exclude git directory
.git

# Exclude various other files not needed in the container
README.md
.gitignore
.vscode
.github

# Exclude logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

.env
.env.*
!.env.example

# Exclude other development files
infra/